# Groq API Configuration for live AI reasoning (RAG-enhanced)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ==============================================================================
# Free Gmail SMTP Configuration for "Book Technical Discovery" Form Submissions
# ==============================================================================
# Instructions for Free Gmail SMTP:
# 1. Go to your Google Account (myaccount.google.com)
# 2. Navigate to "Security" -> Enable "2-Step Verification" (if not already enabled)
# 3. Under 2-Step Verification, select "App passwords" (or search "App passwords")
# 4. Create an App password named "Vyom Agents" (generates a 16-character code)
# 5. Paste your Gmail address and 16-character app password below:

GMAIL_USER=your-company@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: Dedicated email address where internal lead intake notifications are sent
# (Defaults to GMAIL_USER if not specified)
CONTACT_NOTIFICATION_EMAIL=
